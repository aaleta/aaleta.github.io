<footer class="footer">
  <div class="wrap footer__inner">
    <span class="footer__copy">© {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }} & Claude · {{ site.affiliation_short }}</span>
    <a class="footer__email" href="mailto:{{ site.email }}">{{ site.email }}</a>
  </div>
</footer>

{%- comment %} Floating dark/light toggle — bottom-right of the viewport. {% endcomment -%}
<button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
  <span class="theme-toggle__glyph" aria-hidden="true">&#9790;</span>
  <span class="theme-toggle__text">Dark</span>
</button>
