{%- comment %}
  Hero research map — 7 topic labels arranged radially around a centred profile
  photo (the photo is rendered separately in home.liquid as the foreground).
  Ported from scenes/shared.jsx → ResearchMap(): coordinates pre-computed from
  `cx + cos(a) * r * width, cy + sin(a) * r * height` with cx=280, cy=240.
  Hot topics (accent): epidemics, networks, AI.
  All theme colours via currentColor / var(--accent).

  Interactivity (assets/js/research_map.js):
    • Each topic node is wrapped in a <g class="research-map__node"> with
      data-id / data-cx / data-cy. The group is translated each animation
      frame to apply gentle oscillation + pointer drag + spring-back.
    • Every <line> carries data-from / data-to (node id or "center"). The
      animation loop rewrites x1/y1/x2/y2 so links follow their endpoints.
{% endcomment -%}
<svg class="research-map__svg"
     viewBox="0 0 560 480"
     role="img"
     aria-label="Topic map: epidemics, networks, AI, data science, complex systems, collective behaviour, physics."
     preserveAspectRatio="xMidYMid meet">

  <!-- Radial spokes from centre to each topic node -->
  <g class="research-map__spokes" stroke="currentColor" stroke-width="0.6" opacity="0.45" fill="none">
    <line data-from="center" data-to="epidemics"    x1="280" y1="240" x2="380" y2="90"/>
    <line data-from="center" data-to="networks"     x1="280" y1="240" x2="508" y2="190"/>
    <line data-from="center" data-to="data-science" x1="280" y1="240" x2="461" y2="335"/>
    <line data-from="center" data-to="complex"      x1="280" y1="240" x2="307" y2="431"/>
    <line data-from="center" data-to="collective"   x1="280" y1="240" x2="153" y2="375"/>
    <line data-from="center" data-to="ai"           x1="280" y1="240" x2="46"  y2="259"/>
    <line data-from="center" data-to="physics"      x1="280" y1="240" x2="221" y2="65"/>
  </g>

  <!-- Inter-topic faint dashed links -->
  <g class="research-map__cross" stroke="currentColor" stroke-width="0.6" opacity="0.32" stroke-dasharray="2 3" fill="none">
    <line data-from="epidemics" data-to="networks"     x1="380" y1="90"  x2="508" y2="190"/>
    <line data-from="networks"  data-to="data-science" x1="508" y1="190" x2="461" y2="335"/>
    <line data-from="complex"   data-to="collective"   x1="307" y1="431" x2="153" y2="375"/>
    <line data-from="ai"        data-to="networks"     x1="46"  y1="259" x2="508" y2="190"/>
    <line data-from="physics"   data-to="complex"      x1="221" y1="65"  x2="307" y2="431"/>
    <line data-from="epidemics" data-to="ai"           x1="380" y1="90"  x2="46"  y2="259"/>
  </g>

  <!-- Topic nodes -->
  <g class="research-map__nodes">
    <g class="research-map__node" data-id="epidemics" data-cx="380" data-cy="90">
      <circle class="research-map__node-hit" cx="380" cy="90" r="16"/>
      <circle cx="380" cy="90" r="5.5" fill="var(--accent)"/>
      <text x="380" y="80" text-anchor="middle" class="research-map__lbl">epidemics</text>
    </g>

    <g class="research-map__node" data-id="networks" data-cx="508" data-cy="190">
      <circle class="research-map__node-hit" cx="508" cy="190" r="16"/>
      <circle cx="508" cy="190" r="5.5" fill="var(--accent)"/>
      <text x="508" y="180" text-anchor="middle" class="research-map__lbl">networks</text>
    </g>

    <g class="research-map__node" data-id="data-science" data-cx="461" data-cy="335">
      <circle class="research-map__node-hit" cx="461" cy="335" r="16"/>
      <circle cx="461" cy="335" r="4" fill="currentColor"/>
      <text x="461" y="353" text-anchor="middle" class="research-map__lbl">data science</text>
    </g>

    <g class="research-map__node" data-id="complex" data-cx="307" data-cy="431">
      <circle class="research-map__node-hit" cx="307" cy="431" r="16"/>
      <circle cx="307" cy="431" r="4" fill="currentColor"/>
      <text x="307" y="449" text-anchor="middle" class="research-map__lbl">complex systems</text>
    </g>

    <g class="research-map__node" data-id="collective" data-cx="153" data-cy="375">
      <circle class="research-map__node-hit" cx="153" cy="375" r="16"/>
      <circle cx="153" cy="375" r="4" fill="currentColor"/>
      <text x="153" y="393" text-anchor="middle" class="research-map__lbl">collective behaviour</text>
    </g>

    <g class="research-map__node" data-id="ai" data-cx="46" data-cy="259">
      <circle class="research-map__node-hit" cx="46" cy="259" r="16"/>
      <circle cx="46"  cy="259" r="5.5" fill="var(--accent)"/>
      <text x="46"  y="277" text-anchor="middle" class="research-map__lbl">AI</text>
    </g>

    <g class="research-map__node" data-id="physics" data-cx="221" data-cy="65">
      <circle class="research-map__node-hit" cx="221" cy="65" r="16"/>
      <circle cx="221" cy="65"  r="4" fill="currentColor"/>
      <text x="221" y="55"  text-anchor="middle" class="research-map__lbl">physics</text>
    </g>
  </g>
</svg>
