---
layout: default
---
{%- comment %}
  Generic page layout — used by Resources and Academic Advising, plus any
  future short pages. Reads page-header content from front matter:
    page.eyebrow      — mono kicker text (HTML allowed)
    page.title_h1     — h1 (HTML allowed); falls back to page.title
    page.lead         — lead paragraph (HTML allowed); optional
    page.net          — network-bg name (publications | projects | teaching | resources); optional
  Renders {{ content }} inside a centred section beneath the header.
{% endcomment -%}

{%- assign h1_text = page.title_h1 | default: page.title -%}

{% include page_header.liquid
   net=page.net
   eyebrow=page.eyebrow
   title=h1_text
   lead=page.lead %}

<section class="section section--pad-lg page-body">
  <div class="wrap">
    {{ content }}
  </div>
</section>
