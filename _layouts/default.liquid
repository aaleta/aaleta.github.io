<!doctype html>
<html lang="{{ site.lang | default: 'en' }}"{% if page.nav_id %} data-page="{{ page.nav_id }}"{% endif %}>
  <head>
    {%- include head.liquid -%}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    {%- include nav.liquid -%}

    <main id="content" tabindex="-1">
      {{ content }}
    </main>

    {%- include footer.liquid -%}

    <script defer src="{{ '/assets/js/theme.js' | relative_url }}"></script>
    <script defer src="{{ '/assets/js/nav.js' | relative_url }}"></script>
  </body>
</html>
