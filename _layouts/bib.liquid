---
---
{%- comment %}
  jekyll-scholar entry template — emits one paper row in the design's grid:
    [52 mono №] [1fr title + authors (+ optional chips)] [200 venue italic] [90 DOI ↗ accent]
  Fields used: entry.abbr, entry.title, entry.author_array (jekyll-scholar),
               entry.journal, entry.url, entry.selected, entry.keywords.
{% endcomment -%}
{%- assign abbr_num = entry.abbr | default: "" | replace: ".", "" | strip -%}
<article id="{{ entry.key }}" class="paper">
  <div class="paper__num">{%- if abbr_num != "" -%}<span>№&nbsp;{{ abbr_num }}</span>{%- endif -%}</div>

  <div class="paper__main">
    <h3 class="paper__title">
      {%- if entry.url -%}
        <a href="{{ entry.url }}" rel="noopener noreferrer">{{ entry.title }}</a>
      {%- else -%}
        {{ entry.title }}
      {%- endif -%}
      {%- if entry.selected %} <span class="badge" aria-label="Selected publication">SELECTED</span>{%- endif -%}
    </h3>

    <p class="paper__authors">
      {%- for a in entry.author_array -%}
        {%- assign last = a.last -%}
        {%- assign first = a.first -%}
        {%- if last == "Aleta" and first contains "A" -%}
          <em>{{ first }} {{ last }}</em>
        {%- else -%}
          {{ first }} {{ last }}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor -%}
    </p>

    {%- if entry.keywords and entry.keywords != "" -%}
      {%- assign kws = entry.keywords | split: "," -%}
      <ul class="paper__chips">
        {%- for k in kws -%}
          <li class="chip">{{ k | strip }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if entry.note and entry.note != "" -%}
      <p class="paper__note">{{ entry.note }}</p>
    {%- endif -%}
  </div>

  <div class="paper__venue">{%- if entry.journal -%}<em>{{ entry.journal | strip }}</em>{%- endif -%}</div>

  <div class="paper__doi">
    {%- if entry.url -%}
      <a class="link-arrow" href="{{ entry.url }}" rel="noopener noreferrer">DOI&nbsp;↗</a>
    {%- endif -%}
  </div>
</article>
